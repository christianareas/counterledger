{
	"name": "counterledger",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=26",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "next dev -p 3200",
		"dev:tunnel": "ngrok http 3200",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint:all": "npm run lint:markdown ; npm run lint:code",
		"lint:all:write": "npm run lint:markdown:write ; npm run lint:code:write",
		"lint:code": "biome check",
		"lint:code:write": "biome check --write",
		"lint:code:write:unsafe": "biome check --write --unsafe",
		"lint:markdown": "rumdl check",
		"lint:markdown:write": "rumdl check --fix",
		"reinstall:all": "rm -rf node_modules .next .rumdl_cache package-lock.json && npm i",
		"update:all": "npx -y npm-check-updates -u && npm update && biome migrate --write && npm dedupe && npm outdated && npm ls",
		"audit:dependencies": "npm audit",
		"vercel:env:pull": "vercel env pull .env.local",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.0",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.16",
		"next": "^16.4.5",
		"plaid": "^51.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-plaid-link": "^5.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^18.0.9",
		"drizzle-kit": "^0.31.11",
		"rumdl": "^0.3.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
