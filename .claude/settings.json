{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"ask": [
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git merge *)",
			"Bash(gh pr create *)",
			"Bash(gh pr ready *)",
			"Bash(gh pr merge *)"
		],
		"deny": ["Read(**/.env*)", "Bash(git worktree move *)"]
	}
}
